{
    "name": "singraworks/br-fields",
    "description": "Validate, format, and redact Brazilian CPF and CNPJ numbers. Pure PHP, no Composer dependencies.",
    "type": "library",
    "keywords": [
        "brazil",
        "brasil",
        "cpf",
        "cnpj",
        "validation",
        "formatting",
        "redaction",
        "lgpd"
    ],
    "homepage": "https://github.com/singraworks/br-fields",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Vasconcelos",
            "email": "lucasvscn@pm.me"
        }
    ],
    "support": {
        "issues": "https://github.com/singraworks/br-fields/issues",
        "source": "https://github.com/singraworks/br-fields"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/vet": "^0.2.1",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "phpstan/phpstan": "^2.3.1",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "SingraWorks\\BrFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SingraWorks\\BrFields\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "@php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --parallel --test"
        ],
        "test:type-coverage": "@php -d memory_limit=-1 vendor/bin/pest --parallel --type-coverage --min=100",
        "test:coverage": "@php -d memory_limit=-1 vendor/bin/pest --parallel --coverage --min=95",
        "test:mutate": "@php -d memory_limit=-1 vendor/bin/pest --parallel --mutate --covered-only --min=85",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": [
            "@test:lint",
            "@analyse",
            "@test:type-coverage",
            "@test:coverage"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
